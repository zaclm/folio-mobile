{
  "name": "folio",
  "productName": "Folio",
  "version": "1.0.5",
  "description": "Folio - a clean markdown reader and editor",
  "author": "Zac",
  "main": "electron/main.cjs",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build:renderer": "vite build",
    "start": "vite build && electron .",
    "dist:win": "vite build && electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-bubble-menu": "^3.32.0",
    "@tiptap/extension-code-block-lowlight": "^3.32.0",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-list": "^3.32.0",
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/extension-text": "^3.32.0",
    "@tiptap/extensions": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@vscode/markdown-it-katex": "^1.1.2",
    "dompurify": "^3.4.17",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.0",
    "lowlight": "^3.3.0",
    "lucide": "^1.58.0",
    "markdown-it": "^14.3.3",
    "markdown-it-anchor": "^10.0.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "mermaid": "^12.2.0",
    "png-to-ico": "^3.0.2",
    "resedit": "^3.1.0",
    "sharp": "^0.35.5",
    "tiptap-markdown": "^0.9.0",
    "vite": "^8.3.4"
  },
  "overrides": {
    "@vscode/markdown-it-katex": {
      "katex": "$katex"
    }
  },
  "license": "SEE LICENSE IN build/license.txt",
  "homepage": "https://example.com/folio",
  "build": {
    "appId": "com.zac.folio",
    "productName": "Folio",
    "copyright": "Copyright © 2026 Zac",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/main.cjs",
      "electron/preload.cjs",
      "build/icon.png",
      "package.json"
    ],
    "asar": true,
    "afterPack": "build/afterPack.cjs",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": true,
      "executableName": "Folio",
      "signtoolOptions": {
        "signingHashAlgorithms": [
          "sha256"
        ],
        "publisherName": [
          "Zac (Folio)"
        ]
      }
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Folio",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false,
      "artifactName": "Folio-Setup-${version}.exe",
      "runAfterFinish": true,
      "license": "build/license.txt",
      "include": "build/installer.nsh",
      "installerSidebar": "build/installer/sidebar.bmp",
      "uninstallerSidebar": "build/installer/sidebar.bmp",
      "installerHeader": "build/installer/header.bmp",
      "uninstallDisplayName": "Folio"
    },
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown",
          "mdown",
          "mkd"
        ],
        "name": "Markdown document",
        "description": "Markdown document",
        "icon": "build/icon.ico",
        "role": "Editor"
      }
    ],
    "publish": null,
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "onlyLoadAppFromAsar": true,
      "enableEmbeddedAsarIntegrityValidation": true,
      "enableCookieEncryption": true
    },
    "extraFiles": [
      {
        "from": "build/license.txt",
        "to": "LICENSE.txt"
      }
    ]
  }
}
